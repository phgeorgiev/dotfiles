#!/bin/bash

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly RESET='\033[0m'
readonly BOLD='\033[1m'

# Script metadata
readonly SCRIPT_NAME="dot"
# Resolve symlinks to get the actual script location
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
done
DOTFILES_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
readonly DOTFILES_DIR
readonly INSTALL_DIR="${DOTFILES_DIR}/install"

# Helper functions
print_header() {
    echo -e "\n${BOLD}${BLUE}==>${RESET} ${BOLD}$1${RESET}\n"
}

print_success() {
    echo -e "${GREEN}✓${RESET} $1"
}

print_error() {
    echo -e "${RED}✗${RESET} $1" >&2
}

print_warning() {
    echo -e "${YELLOW}⚠${RESET} $1"
}

print_info() {
    echo -e "${CYAN}$1${RESET}"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

ask_confirmation() {
    local message="${1:-Do you want to proceed with these changes?}"
    local default="${2:-N}"

    if [[ "$default" =~ ^[Yy]$ ]]; then
        local prompt="(Y/n)"
    else
        local prompt="(y/N)"
    fi

    read -p "$message $prompt: " -n 1 -r
    echo ""

    # If no input (just Enter), use default
    if [[ -z "$REPLY" ]]; then
        if [[ "$default" =~ ^[Yy]$ ]]; then
            return 0
        else
            print_warning "Operation cancelled"
            return 1
        fi
    fi

    # Check user input
    if [[ "$REPLY" =~ ^[Yy]$ ]]; then
        return 0
    elif [[ "$REPLY" =~ ^[Nn]$ ]]; then
        print_warning "Operation cancelled"
        return 1
    else
        print_warning "Invalid input. Operation cancelled"
        return 1
    fi
}

install_homebrew() {
    if command_exists brew; then
        print_success "Homebrew is already installed"
        return 0
    fi

    print_header "Installing Homebrew"
    print_info "This will install Homebrew package manager..."

    if /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
        print_success "Homebrew installed successfully"

        # Add brew to PATH for current session
        if [[ $(uname -m) == 'arm64' ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        else
            eval "$(/usr/local/bin/brew shellenv)"
        fi
        print_info "Added Homebrew to PATH for this session"
    else
        print_error "Failed to install Homebrew"
        return 1
    fi
}

install_zsh() {
    if command_exists zsh; then
        print_success "Zsh is already installed"
    else
        print_error "Zsh is not installed"
        print_info "Please install Zsh first: brew install zsh"
        return 1
    fi

    # Set zsh as default shell if not already
    local current_shell
    current_shell="$(dscl . -read /Users/"$USER" UserShell | cut -d: -f2 | xargs)"
    local zsh_path
    zsh_path="$(which zsh)"

    if [[ "$current_shell" != "$zsh_path" ]]; then
        print_info "Setting Zsh as default shell..."
        if sudo chsh -s "$zsh_path" "$USER"; then
            print_success "Zsh set as default shell"
            print_info "Restart your terminal to use Zsh"
        else
            print_warning "Failed to set Zsh as default shell"
            print_info "You can change it manually with: chsh -s $(which zsh)"
        fi
    else
        print_success "Zsh is already the default shell"
    fi

    # Install oh-my-zsh
    local omz_dir="${HOME}/.oh-my-zsh"

    if [[ -d "$omz_dir" ]]; then
        print_success "Oh My Zsh is already installed"
    else
        print_header "Installing Oh My Zsh"
        print_info "This will install Oh My Zsh framework..."

        # Install oh-my-zsh non-interactively
        if RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"; then
            print_success "Oh My Zsh installed successfully"
        else
            print_error "Failed to install Oh My Zsh"
            return 1
        fi
    fi

    # Install powerlevel10k theme
    local p10k_dir="${HOME}/.oh-my-zsh/custom/themes/powerlevel10k"

    if [[ -d "$p10k_dir" ]]; then
        print_success "Powerlevel10k is already installed"
    else
        print_header "Installing Powerlevel10k theme"
        print_info "This will install the Powerlevel10k Zsh theme..."

        # Clone powerlevel10k
        if git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$p10k_dir"; then
            print_success "Powerlevel10k installed successfully"
            print_info "To configure powerlevel10k, run: p10k configure"
        else
            print_error "Failed to install Powerlevel10k"
            return 1
        fi
    fi
}

install_composer() {
    if command_exists composer; then
        print_success "Composer is already installed"
        return 0
    fi

    if ! command_exists php; then
        print_error "PHP is not installed"
        print_info "Install PHP first: brew install php"
        return 1
    fi

    print_header "Installing Composer"
    print_info "This will install Composer PHP dependency manager..."

    # Download and install composer
    local expected_checksum
    local actual_checksum

    expected_checksum="$(php -r 'copy("https://composer.github.io/installer.sig", "php://stdout");')" || {
        print_error "Failed to get installer checksum"
        return 1
    }

    php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" || {
        print_error "Failed to download composer installer"
        return 1
    }

    actual_checksum="$(php -r "echo hash_file('sha384', 'composer-setup.php');")" || {
        print_error "Failed to calculate installer checksum"
        rm -f composer-setup.php
        return 1
    }

    if [[ "$expected_checksum" != "$actual_checksum" ]]; then
        print_error "Invalid installer checksum"
        rm composer-setup.php
        return 1
    fi

    if php composer-setup.php --quiet && rm composer-setup.php; then
        # Move to /usr/local/bin for global access
        if sudo mv composer.phar /usr/local/bin/composer; then
            print_success "Composer installed successfully"
            print_info "Composer is now available globally as 'composer'"

            # Run composer setup script if it exists
            local composer_setup="${INSTALL_DIR}/composer.sh"
            if [[ -f "$composer_setup" ]]; then
                print_info "Running composer setup script..."
                if bash "$composer_setup"; then
                    print_success "Composer setup completed"
                else
                    print_warning "Composer setup script failed"
                fi
            fi
        else
            print_warning "Composer installed but failed to move to global location"
            print_info "You can move it manually: sudo mv composer.phar /usr/local/bin/composer"
        fi
    else
        print_error "Failed to install Composer"
        rm -f composer-setup.php composer.phar
        return 1
    fi
}

install_packages() {
    if ! command_exists brew; then
        print_error "Homebrew is not installed"
        print_info "Run 'dot init' to install Homebrew first"
        return 1
    fi

    if [[ ! -f "${INSTALL_DIR}/Brewfile" ]]; then
        print_warning "No Brewfile found at ${INSTALL_DIR}/Brewfile"
        print_info "Create a Brewfile to manage packages with 'brew bundle dump'"
        return 1
    fi

    print_header "Checking packages from Brewfile"
    print_info "Using Brewfile at ${INSTALL_DIR}/Brewfile"

    if brew bundle check --file="${INSTALL_DIR}/Brewfile"; then
        print_success "All packages are already installed"
    else
        print_header "Installing missing packages from Brewfile"
        if brew bundle --file="${INSTALL_DIR}/Brewfile"; then
            print_success "Packages installed from Brewfile"
            jenv_register_all
        else
            print_error "Failed to install packages from Brewfile"
            return 1
        fi
    fi
}

# Init command
cmd_init() {
    print_header "Initializing dotfiles setup"

    install_homebrew || return 1
    install_packages || return 1
    install_zsh || return 1
    cmd_stow || return 1
    cmd_link || return 1

    install_composer || print_warning "Composer installation failed, continuing..."

    echo
    print_success "Dotfiles initialization complete! 🎉"
}

# Update command
cmd_update() {
    print_header "Updating dotfiles"

    print_info "Pulling changes..."
    if git -C "${DOTFILES_DIR}" pull; then
        print_success "Dotfiles updated successfully"
    else
        print_error "Failed to fetch from remote"
        return 1
    fi

    # Update packages
    if ask_confirmation "Do you want to update Homebrew packages?" "y"; then
        brew update
        brew upgrade
        print_success "Homebrew packages updated successfully"
    fi

    # Re-stow dotfiles
    if ask_confirmation "Re-stow dotfiles?" "y"; then
        cmd_stow
    fi
}

# Stow command
cmd_stow() {
    print_header "Stowing dotfiles"

    if ! command_exists stow; then
        print_error "GNU Stow is not installed"
        print_info "Install it first: brew install stow"
        return 1
    fi

    print_info "Creating symlinks for dotfiles..."

    if stow -R -v -d "${DOTFILES_DIR}" -t "${HOME}" home; then
        print_success "Dotfiles stowed successfully"
        print_info "Configuration files are now symlinked to your home directory"
    else
        print_error "Failed to stow dotfiles"
        print_info "Check for conflicting files in your home directory"
        return 1
    fi
}

# Package command
cmd_package() {
    local subcmd="${1:-help}"
    shift || true

    case "$subcmd" in
        add)
            package_add "$@"
            ;;
        clean)
            package_clean "$@"
            ;;
        link)
            package_link "$@"
            ;;
        remove)
            package_remove "$@"
            ;;
        update)
            package_update "$@"
            ;;
        check)
            package_check "$@"
            ;;
        sync)
            package_sync "$@"
            ;;
        outdated)
            package_outdated "$@"
            ;;
        help|*)
            echo "Usage: dot package [SUBCOMMAND]"
            echo ""
            echo "Package management subcommands:"
            echo "  add         Add packages to Brewfile and install them"
            echo "  check       Check installed vs missing packages from Brewfile"
            echo "  clean       Remove unused packages and cleanup Homebrew"
            echo "  link        Switch between package versions"
            echo "  outdated    Check for outdated packages from Brewfile"
            echo "  remove      Remove packages from Brewfile and uninstall them"
            echo "  sync        Interactively install/remove packages to match Brewfile"
            echo "  update      Update packages (all|package names)"
            echo ""
            echo "Examples:"
            echo "  dot package add git vim       Add packages to Brewfile and install"
            echo "  dot package remove git vim    Remove packages from Brewfile and uninstall"
            echo "  dot package update all        Update all packages in Brewfile"
            echo "  dot package update git vim    Update specific packages"
            echo "  dot package link node@22      Switch to node version 22"
            echo "  dot package link list         List available packages and versions"
            echo "  dot package check             Check installed vs missing packages"
            echo "  dot package sync              Interactively sync packages with Brewfile"
            echo "  dot package outdated          Check for outdated packages"
            echo "  dot package clean             Clean up unused packages"
            ;;
    esac
}

jenv_register_all() {
    if ! command_exists jenv; then
        return 0
    fi

    print_info "Registering JDKs with jenv..."
    while IFS= read -r home; do
        [[ -z "$home" ]] && continue
        jenv add "$home" 2>/dev/null && print_success "Registered: $home" || true
    done < <(find /Library/Java/JavaVirtualMachines -maxdepth 3 -name "Home" 2>/dev/null)
}

package_add() {
    if ! command_exists brew; then
        print_error "Homebrew is not installed"
        return 1
    fi

    if [[ $# -eq 0 ]]; then
        print_error "No packages specified"
        print_info "Usage: dot package add <package1> [package2] ..."
        return 1
    fi

    print_header "Adding packages to Brewfile"
    print_info "Adding packages: $*"
    local failed=0
    for package in "$@"; do
        local package_type
        package_type=$(brew info --json=v2 "$package" 2>/dev/null | jq -r '.casks // empty | if length > 0 then "cask" else empty end')
        if [[ "$package_type" == "cask" ]]; then
            if ! brew bundle add --file="${INSTALL_DIR}/Brewfile" --cask "$package"; then
                print_error "Failed to add cask: $package"
                failed=1
            else
                if ! brew install --cask "$package"; then
                    print_error "Failed to install cask: $package"
                    failed=1
                elif [[ "$package" == temurin* ]]; then
                    jenv_register_all
                fi
            fi
        else
            if ! brew bundle add --file="${INSTALL_DIR}/Brewfile" "$package"; then
                print_error "Failed to add formula: $package"
                failed=1
            else
                if ! brew install "$package"; then
                    print_error "Failed to install formula: $package"
                    failed=1
                fi
            fi
        fi
    done

    if [[ $failed -eq 0 ]]; then
        print_success "Packages added to Brewfile and installed"
    else
        print_error "Some packages failed to add"
    fi

    if ask_confirmation "Do you want to reorganize the Brewfile?" "y"; then
        reorganize_brewfile
        print_success "Brewfile reorganized"
    fi
}

reorganize_brewfile() {
    local brewfile="${INSTALL_DIR}/Brewfile"
    local temp_file="${brewfile}.tmp"
    # Extract header comments, brew entries, and cask entries
    {
        # Keep header comments and empty lines before first brew/cask entry
        local header
        header=$(awk '/^(brew|cask)/ {exit} {print}' "$brewfile")
        echo "$header"

        # Add Regular packages comment if not present in header
        if ! echo "$header" | grep -q "# Regular packages"; then
            echo "# Regular packages"
        fi
        # Extract, sort and deduplicate brew entries
        grep '^brew ' "$brewfile" | sort -u
        echo ""
        # Add Cask packages comment if not present in header
        if ! echo "$header" | grep -q "# Cask packages"; then
            echo "# Cask packages"
        fi
        # Extract, sort and deduplicate cask entries
        grep '^cask ' "$brewfile" | sort -u
    } > "$temp_file"
    mv "$temp_file" "$brewfile"
}

package_link() {
    if ! command_exists brew; then
        print_error "Homebrew is not installed"
        return 1
    fi

    get_versions() {
        local package_name="$1"
        brew ls --versions | grep "^${package_name}[ @]" | sed 's/ .*//'
    }

    get_linkable_families() {
        brew ls --versions | awk '{print $1}' | sed 's/@.*//' | sort | uniq -c | awk '$1 >= 2 {print $2}'
    }

    list_packages() {
        print_header "Available packages"
        local linked_formulas
        linked_formulas=$(brew info --json=v2 --installed --formula 2>/dev/null | \
            jq -r '.formulae[] | select(.linked_keg != null) | .name' 2>/dev/null || true)

        local families
        families=$(get_linkable_families)
        if [[ -z "$families" ]]; then
            print_info "No linkable package families found (need 2+ installed variants)"
            return 0
        fi

        local output=""
        while IFS= read -r package; do
            [[ -z "$package" ]] && continue
            while IFS= read -r entry; do
                [[ -z "$entry" ]] && continue
                local name ver status
                name=$(echo "$entry" | awk '{print $1}')
                ver=$(echo "$entry" | awk '{print $2}')
                if echo "$linked_formulas" | grep -q "^${name}$"; then
                    status="(active)"
                else
                    status=""
                fi
                output+="  ${name}\t${ver}\t${status}\n"
            done < <(brew ls --versions | grep "^${package}[ @]")
            output+="\n"
        done <<< "$families"
        echo -e "$output" | column -t -s $'\t'
    }

    if [[ $# -eq 0 ]] || [[ "$1" == "list" ]]; then
        list_packages
        return 0
    fi

    if [[ $# -ne 1 ]]; then
        print_error "Invalid arguments"
        print_info "Usage: dot package link <package>[@<version>] or dot package link list"
        return 1
    fi

    local package_name="${1//@*}"
    local version="$1"

    if ! get_linkable_families | grep -qx "$package_name"; then
        print_error "$package_name has fewer than 2 installed variants — nothing to switch"
        print_info "Linkable packages:"
        get_linkable_families | sed 's/^/  - /'
        return 1
    fi

    if ! brew list "$version" &>/dev/null; then
        print_error "${version} is not installed"
        print_info "Install it first with: brew install $version"
        return 1
    fi

    print_header "Switching package version"
    print_info "Package: $package_name -> $version"
    echo ""

    print_info "Versions to unlink:"
    for v in $(get_versions "$package_name"); do
        echo "  - $v"
    done
    print_info "Version to link: $version"
    echo ""

    if ! ask_confirmation "Do you want to proceed with these changes?" "y"; then
        return 0
    fi

    print_info "Executing changes..."
    for v in $(get_versions "$package_name"); do
        if brew unlink "$v" 2>/dev/null; then
            print_info "Unlinked: $v"
        fi
    done

    if brew link "$version"; then
        print_success "Successfully linked: $version"
    else
        print_error "Failed to link: $version"
        return 1
    fi
}

package_remove() {
    if ! command_exists brew; then
        print_error "Homebrew is not installed"
        return 1
    fi

    if [[ $# -eq 0 ]]; then
        print_error "No packages specified"
        print_info "Usage: dot package remove <package1> [package2] ..."
        return 1
    fi

    print_header "Removing packages from Brewfile"
    print_info "Removing packages: $*"

    for package in "$@"; do
        if brew bundle remove --file="${INSTALL_DIR}/Brewfile" "$package"; then
            print_success "Packages removed from Brewfile"
            if ! brew uninstall "$package"; then
                print_warning "Failed to uninstall package: $package"
            else
                print_success "Package uninstalled: $package"
            fi
        else
            print_error "Failed to remove package: $package"
        fi
    done
}

package_clean() {
    if ! command_exists brew; then
        print_error "Homebrew is not installed"
        return 1
    fi

    if [[ ! -f "${INSTALL_DIR}/Brewfile" ]]; then
        print_warning "No Brewfile found at ${INSTALL_DIR}/Brewfile"
        print_info "Create a Brewfile to manage packages with 'brew bundle dump'"
        return 1
    fi

    print_header "Cleaning up packages"

    print_info "Removing packages not listed in Brewfile..."
    if brew bundle cleanup --file="${INSTALL_DIR}/Brewfile"; then
        print_success "Cleaned up packages not in Brewfile"
    else
        print_warning "Failed to cleanup packages"
    fi

    print_info "Cleaning up Homebrew cache..."
    if brew cleanup; then
        print_success "Cleaned up Homebrew cache"
    else
        print_warning "Failed to clean up cache"
    fi
}

package_update() {
    if ! command_exists brew; then
        print_error "Homebrew is not installed"
        return 1
    fi

    if [[ $# -eq 0 ]]; then
        print_error "Missing argument"
        print_info "Usage: dot package update all|<package1> [package2] ..."
        print_info "Examples:"
        print_info "  dot package update all          Update all packages from Brewfile"
        print_info "  dot package update git vim      Update specific packages"
        return 1
    fi

    # Update Homebrew first
    print_info "Updating Homebrew..."
    if brew update; then
        print_success "Homebrew updated successfully"
    else
        print_error "Failed to update Homebrew"
        return 1
    fi

    if [[ "$1" == "all" ]]; then
        # Update all packages from Brewfile
        if [[ ! -f "${INSTALL_DIR}/Brewfile" ]]; then
            print_warning "No Brewfile found at ${INSTALL_DIR}/Brewfile"
            print_info "Create a Brewfile to manage packages with 'brew bundle dump'"
            return 1
        fi

        print_header "Updating all packages from Brewfile"
        print_info "Using Brewfile at ${INSTALL_DIR}/Brewfile"

        # Upgrade packages listed in Brewfile
        print_info "Upgrading packages from Brewfile..."
        if brew bundle --file="${INSTALL_DIR}/Brewfile"; then
            print_success "All packages updated from Brewfile"
            jenv_register_all
        else
            print_error "Failed to update packages from Brewfile"
            return 1
        fi
    else
        # Update specific packages
        print_header "Updating specific packages"
        print_info "Updating packages: $*"

        local failed_packages=()
        for package in "$@"; do
            print_info "Updating $package..."
            if brew upgrade "$package" 2>/dev/null; then
                print_success "Updated $package"
            else
                # Try installing if not installed
                if brew install "$package"; then
                    print_success "Installed $package"
                else
                    print_error "Failed to update/install $package"
                    failed_packages+=("$package")
                fi
            fi
        done

        if [[ ${#failed_packages[@]} -gt 0 ]]; then
            print_warning "Failed to update packages: ${failed_packages[*]}"
            return 1
        else
            print_success "All specified packages updated successfully"
        fi
    fi

    # Optional cleanup
    if ask_confirmation "Do you want to clean up old package versions?" "y"; then
        if brew cleanup; then
            print_success "Cleaned up old package versions"
        else
            print_warning "Failed to clean up old versions"
        fi
    fi
}

package_check() {
    if ! command_exists brew; then
        print_error "Homebrew is not installed"
        return 1
    fi

    print_header "Checking installed packages"

    local missing_brew=()
    local missing_cask=()
    local installed_brew=()
    local installed_cask=()
    local untracked_brew=()
    local untracked_cask=()

    # Get lists of installed packages
    # Use 'brew leaves' to get only directly installed formulas (not dependencies)
    local installed_formulas
    local installed_casks
    installed_formulas=$(brew leaves 2>/dev/null || true)
    installed_casks=$(brew list --cask 2>/dev/null || true)

    # Read Brewfile and extract package names
    local brewfile_formulas
    local brewfile_casks
    brewfile_formulas=$(grep '^brew ' "${INSTALL_DIR}/Brewfile" | sed 's/^brew "\([^"]*\)".*/\1/' | sed 's|.*/||')
    brewfile_casks=$(grep '^cask ' "${INSTALL_DIR}/Brewfile" | sed 's/^cask "\([^"]*\)".*/\1/')

    # Check each formula from Brewfile
    while IFS= read -r formula; do
        [[ -z "$formula" ]] && continue
        if echo "$installed_formulas" | grep -q "^${formula}$"; then
            installed_brew+=("$formula")
        else
            missing_brew+=("$formula")
        fi
    done <<< "$brewfile_formulas"

    # Check each cask from Brewfile
    while IFS= read -r cask; do
        [[ -z "$cask" ]] && continue
        if echo "$installed_casks" | grep -q "^${cask}$"; then
            installed_cask+=("$cask")
        else
            missing_cask+=("$cask")
        fi
    done <<< "$brewfile_casks"

    # Check for installed packages not in Brewfile
    while IFS= read -r formula; do
        [[ -z "$formula" ]] && continue
        if ! echo "$brewfile_formulas" | grep -q "^${formula}$"; then
            untracked_brew+=("$formula")
        fi
    done <<< "$installed_formulas"

    # Check for installed casks not in Brewfile
    while IFS= read -r cask; do
        [[ -z "$cask" ]] && continue
        if ! echo "$brewfile_casks" | grep -q "^${cask}$"; then
            untracked_cask+=("$cask")
        fi
    done <<< "$installed_casks"

    # Display results
    print_success "Installed formulas (${#installed_brew[@]}):"
    for formula in "${installed_brew[@]}"; do
        echo "  ✓ $formula"
    done

    if [[ ${#missing_brew[@]} -gt 0 ]]; then
        echo ""
        print_warning "Missing formulas (${#missing_brew[@]}):"
        for formula in "${missing_brew[@]}"; do
            echo "  ✗ $formula"
        done
    fi

    echo ""
    print_success "Installed casks (${#installed_cask[@]}):"
    for cask in "${installed_cask[@]}"; do
        echo "  ✓ $cask"
    done

    if [[ ${#missing_cask[@]} -gt 0 ]]; then
        echo ""
        print_warning "Missing casks (${#missing_cask[@]}):"
        for cask in "${missing_cask[@]}"; do
            echo "  ✗ $cask"
        done
    fi

    # Display untracked packages
    if [[ ${#untracked_brew[@]} -gt 0 ]]; then
        echo ""
        print_info "Untracked formulas (${#untracked_brew[@]}) - installed but not in Brewfile:"
        for formula in "${untracked_brew[@]}"; do
            echo "  • $formula"
        done
    fi

    if [[ ${#untracked_cask[@]} -gt 0 ]]; then
        echo ""
        print_info "Untracked casks (${#untracked_cask[@]}) - installed but not in Brewfile:"
        for cask in "${untracked_cask[@]}"; do
            echo "  • $cask"
        done
    fi

    # Summary
    local total_expected=$((${#installed_brew[@]} + ${#missing_brew[@]} + ${#installed_cask[@]} + ${#missing_cask[@]}))
    local total_installed=$((${#installed_brew[@]} + ${#installed_cask[@]}))
    local total_missing=$((${#missing_brew[@]} + ${#missing_cask[@]}))
    local total_untracked=$((${#untracked_brew[@]} + ${#untracked_cask[@]}))

    echo ""
    if [[ $total_missing -eq 0 ]] && [[ $total_untracked -eq 0 ]]; then
        print_success "All packages from Brewfile are installed and no untracked packages found! ($total_installed/$total_expected)"
    else
        print_info "Summary: $total_installed/$total_expected packages installed"
        if [[ $total_missing -gt 0 ]]; then
            print_info "  - $total_missing missing from system"
            echo ""
            print_info "To install missing packages, run: dot package update all"
        fi
        if [[ $total_untracked -gt 0 ]]; then
            print_info "  - $total_untracked installed but not in Brewfile"
        fi
    fi
}

package_sync() {
    if ! command_exists brew; then
        print_error "Homebrew is not installed"
        return 1
    fi

    if [[ ! -f "${INSTALL_DIR}/Brewfile" ]]; then
        print_warning "No Brewfile found at ${INSTALL_DIR}/Brewfile"
        return 1
    fi

    print_header "Syncing packages with Brewfile"

    local missing_brew=()
    local missing_cask=()
    local untracked_brew=()
    local untracked_cask=()

    local installed_formulas
    local all_installed_formulas
    local installed_casks
    installed_formulas=$(brew leaves 2>/dev/null | sed 's|.*/||' || true)
    all_installed_formulas=$(brew list --formula 2>/dev/null | sed 's|.*/||' || true)
    installed_casks=$(brew list --cask 2>/dev/null || true)

    local brewfile_formulas
    local brewfile_casks
    brewfile_formulas=$(grep '^brew ' "${INSTALL_DIR}/Brewfile" | sed 's/^brew "\([^"]*\)".*/\1/' | sed 's|.*/||')
    brewfile_casks=$(grep '^cask ' "${INSTALL_DIR}/Brewfile" | sed 's/^cask "\([^"]*\)".*/\1/')

    while IFS= read -r formula; do
        [[ -z "$formula" ]] && continue
        if ! echo "$all_installed_formulas" | grep -q "^${formula}$"; then
            missing_brew+=("$formula")
        fi
    done <<< "$brewfile_formulas"

    while IFS= read -r cask; do
        [[ -z "$cask" ]] && continue
        if ! echo "$installed_casks" | grep -q "^${cask}$"; then
            missing_cask+=("$cask")
        fi
    done <<< "$brewfile_casks"

    while IFS= read -r formula; do
        [[ -z "$formula" ]] && continue
        if ! echo "$brewfile_formulas" | grep -q "^${formula}$"; then
            untracked_brew+=("$formula")
        fi
    done <<< "$installed_formulas"

    while IFS= read -r cask; do
        [[ -z "$cask" ]] && continue
        if ! echo "$brewfile_casks" | grep -q "^${cask}$"; then
            untracked_cask+=("$cask")
        fi
    done <<< "$installed_casks"

    local did_something=0

    if [[ ${#missing_brew[@]} -gt 0 ]] || [[ ${#missing_cask[@]} -gt 0 ]]; then
        print_warning "Packages to install (in Brewfile, not installed):"
        for formula in "${missing_brew[@]+"${missing_brew[@]}"}"; do
            read -p "  Install formula: $formula? (Y/n): " -n 1 -r; echo ""
            if [[ -z "$REPLY" ]] || [[ "$REPLY" =~ ^[Yy]$ ]]; then
                brew install "$formula" && print_success "Installed $formula" || print_error "Failed to install $formula"
                did_something=1
            fi
        done
        for cask in "${missing_cask[@]+"${missing_cask[@]}"}"; do
            read -p "  Install cask: $cask? (Y/n): " -n 1 -r; echo ""
            if [[ -z "$REPLY" ]] || [[ "$REPLY" =~ ^[Yy]$ ]]; then
                brew install --cask "$cask" && print_success "Installed $cask" || print_error "Failed to install $cask"
                if [[ "$cask" == temurin* ]]; then
                    jenv_register_all
                fi
                did_something=1
            fi
        done
    fi

    if [[ ${#untracked_brew[@]} -gt 0 ]] || [[ ${#untracked_cask[@]} -gt 0 ]]; then
        echo ""
        print_info "Packages to remove (installed, not in Brewfile):"
        for formula in "${untracked_brew[@]+"${untracked_brew[@]}"}"; do
            read -p "  Remove formula: $formula? (y/N): " -n 1 -r; echo ""
            if [[ "$REPLY" =~ ^[Yy]$ ]]; then
                brew uninstall "$formula" && print_success "Removed $formula" || print_error "Failed to remove $formula"
                did_something=1
            fi
        done
        for cask in "${untracked_cask[@]+"${untracked_cask[@]}"}"; do
            read -p "  Remove cask: $cask? (y/N): " -n 1 -r; echo ""
            if [[ "$REPLY" =~ ^[Yy]$ ]]; then
                brew uninstall --cask "$cask" && print_success "Removed $cask" || print_error "Failed to remove $cask"
                did_something=1
            fi
        done
    fi

    if [[ $did_something -eq 0 ]]; then
        print_success "Everything is in sync"
    fi
}

package_outdated() {
    if ! command_exists brew; then
        print_error "Homebrew is not installed"
        return 1
    fi

    if [[ ! -f "${INSTALL_DIR}/Brewfile" ]]; then
        print_warning "No Brewfile found at ${INSTALL_DIR}/Brewfile"
        print_info "Create a Brewfile to manage packages with 'brew bundle dump'"
        return 1
    fi

    print_header "Checking for outdated packages"

    # Get all outdated packages with version info
    local outdated_formulas_full
    local outdated_casks_full
    outdated_formulas_full=$(brew outdated --formula --verbose 2>/dev/null || true)
    outdated_casks_full=$(brew outdated --cask --greedy --verbose 2>/dev/null || true)

    # Read Brewfile and extract package names
    local brewfile_formulas
    local brewfile_casks
    brewfile_formulas=$(grep '^brew ' "${INSTALL_DIR}/Brewfile" | sed 's/^brew "\([^"]*\)".*/\1/' | sed 's|.*/||')
    brewfile_casks=$(grep '^cask ' "${INSTALL_DIR}/Brewfile" | sed 's/^cask "\([^"]*\)".*/\1/')

    local outdated_brew_lines=()
    local outdated_cask_lines=()

    # Filter outdated formulas that are in Brewfile
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        # Extract package name from the line (first word)
        local package_name
        package_name=$(echo "$line" | awk '{print $1}')
        if echo "$brewfile_formulas" | grep -q "^${package_name}$"; then
            outdated_brew_lines+=("$line")
        fi
    done <<< "$outdated_formulas_full"

    # Filter outdated casks that are in Brewfile
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        # Extract package name from the line (first word)
        local package_name
        package_name=$(echo "$line" | awk '{print $1}')
        if echo "$brewfile_casks" | grep -q "^${package_name}$"; then
            outdated_cask_lines+=("$line")
        fi
    done <<< "$outdated_casks_full"

    # Display results
    if [[ ${#outdated_brew_lines[@]} -eq 0 ]] && [[ ${#outdated_cask_lines[@]} -eq 0 ]]; then
        print_success "All packages from Brewfile are up to date!"
        return 0
    fi

    if [[ ${#outdated_brew_lines[@]} -gt 0 ]]; then
        print_warning "Outdated formulas (${#outdated_brew_lines[@]}):"
        for line in "${outdated_brew_lines[@]}"; do
            echo "  ⬆ $line"
        done
    fi

    if [[ ${#outdated_cask_lines[@]} -gt 0 ]]; then
        echo ""
        print_warning "Outdated casks (${#outdated_cask_lines[@]}):"
        for line in "${outdated_cask_lines[@]}"; do
            echo "  ⬆ $line"
        done
    fi

    local total_outdated=$((${#outdated_brew_lines[@]} + ${#outdated_cask_lines[@]}))
    echo ""
    print_info "Total outdated packages: $total_outdated"
    print_info "To update all packages, run: dot package update all"
}

cmd_npm() {
    local subcmd="${1:-help}"
    shift || true

    case "$subcmd" in
        add)
            npm_add "$@"
            ;;
        remove)
            npm_remove "$@"
            ;;
        check)
            npm_check "$@"
            ;;
        sync)
            npm_sync "$@"
            ;;
        freeze)
            npm_freeze "$@"
            ;;
        help|*)
            echo "Usage: dot npm [SUBCOMMAND]"
            echo ""
            echo "Global npm package management subcommands:"
            echo "  add         Install packages globally and add to Npmfile"
            echo "  remove      Uninstall packages globally and remove from Npmfile"
            echo "  check       Show installed vs missing vs untracked packages"
            echo "  sync        Interactively install missing / remove untracked packages"
            echo "  freeze      Snapshot current globals into Npmfile"
            echo ""
            echo "Examples:"
            echo "  dot npm add typescript prettier     Install and track packages"
            echo "  dot npm remove typescript           Uninstall and untrack a package"
            echo "  dot npm check                       Show drift between Npmfile and system"
            echo "  dot npm sync                        Bring system in line with Npmfile"
            echo "  dot npm freeze                      Overwrite Npmfile with current globals"
            ;;
    esac
}

_npm_npmfile() {
    echo "${INSTALL_DIR}/Npmfile"
}

_npm_list_npmfile() {
    local npmfile
    npmfile=$(_npm_npmfile)
    [[ ! -f "$npmfile" ]] && return
    grep -v '^\s*#' "$npmfile" | grep -v '^\s*$' | while IFS= read -r pkg; do
        if [[ "$pkg" == @*/*@* ]]; then
            # scoped with version: @scope/name@version → @scope/name
            echo "${pkg%@*}"
        elif [[ "$pkg" != @* && "$pkg" == *@* ]]; then
            # regular with version: name@version → name (exclude scoped packages)
            echo "${pkg%@*}"
        else
            echo "$pkg"
        fi
    done
}

_npm_list_npmfile_raw() {
    local npmfile
    npmfile=$(_npm_npmfile)
    [[ ! -f "$npmfile" ]] && return
    grep -v '^\s*#' "$npmfile" | grep -v '^\s*$'
}

_npm_list_global() {
    npm list -g --depth=0 --parseable 2>/dev/null \
        | tail -n +2 \
        | awk -F'/' '{
            if ($(NF-1) ~ /^@/) { print $(NF-1) "/" $NF }
            else { print $NF }
        }' \
        | grep -v '^npm$'
}

npm_add() {
    if ! command_exists npm; then
        print_error "npm is not installed"
        return 1
    fi

    if [[ $# -eq 0 ]]; then
        print_error "No packages specified"
        print_info "Usage: dot npm add <package1> [package2] ..."
        return 1
    fi

    local npmfile
    npmfile=$(_npm_npmfile)
    local failed=0

    print_header "Adding global npm packages"

    for pkg in "$@"; do
        print_info "Installing $pkg..."
        if npm install -g "$pkg"; then
            print_success "Installed $pkg"
            if ! grep -qxF "$pkg" "$npmfile" 2>/dev/null; then
                echo "$pkg" >> "$npmfile"
                print_success "Added $pkg to Npmfile"
            else
                print_info "$pkg already in Npmfile"
            fi
        else
            print_error "Failed to install $pkg"
            failed=1
        fi
    done

    [[ $failed -eq 0 ]] || return 1
}

npm_remove() {
    if ! command_exists npm; then
        print_error "npm is not installed"
        return 1
    fi

    if [[ $# -eq 0 ]]; then
        print_error "No packages specified"
        print_info "Usage: dot npm remove <package1> [package2] ..."
        return 1
    fi

    local npmfile
    npmfile=$(_npm_npmfile)
    local failed=0

    print_header "Removing global npm packages"

    for pkg in "$@"; do
        print_info "Uninstalling $pkg..."
        if npm uninstall -g "$pkg"; then
            print_success "Uninstalled $pkg"
        else
            print_warning "Failed to uninstall $pkg (may not be installed)"
            failed=1
        fi
        # Remove from Npmfile regardless (clean up stale entries too)
        if [[ -f "$npmfile" ]]; then
            local tmp="${npmfile}.tmp"
            grep -vxF "$pkg" "$npmfile" > "$tmp" && mv "$tmp" "$npmfile"
            print_success "Removed $pkg from Npmfile"
        fi
    done

    [[ $failed -eq 0 ]] || return 1
}

npm_check() {
    if ! command_exists npm; then
        print_error "npm is not installed"
        return 1
    fi

    local npmfile
    npmfile=$(_npm_npmfile)

    if [[ ! -f "$npmfile" ]]; then
        print_warning "No Npmfile found at $npmfile"
        print_info "Run 'dot npm freeze' to create one from your current globals"
        return 1
    fi

    print_header "Checking global npm packages"

    local tracked=()
    local installed=()
    local missing=()
    local untracked=()

    while IFS= read -r line; do tracked+=("$line"); done < <(_npm_list_npmfile)
    while IFS= read -r line; do installed+=("$line"); done < <(_npm_list_global)

    for pkg in "${tracked[@]}"; do
        [[ -z "$pkg" ]] && continue
        local found=0
        for inst in "${installed[@]}"; do
            [[ "$inst" == "$pkg" ]] && found=1 && break
        done
        [[ $found -eq 0 ]] && missing+=("$pkg")
    done

    for inst in "${installed[@]}"; do
        [[ -z "$inst" ]] && continue
        local found=0
        for pkg in "${tracked[@]}"; do
            [[ "$pkg" == "$inst" ]] && found=1 && break
        done
        [[ $found -eq 0 ]] && untracked+=("$inst")
    done

    print_success "Tracked and installed ($(( ${#tracked[@]} - ${#missing[@]} ))):"
    for pkg in "${tracked[@]}"; do
        [[ -z "$pkg" ]] && continue
        local is_missing=0
        for m in "${missing[@]}"; do [[ "$m" == "$pkg" ]] && is_missing=1 && break; done
        [[ $is_missing -eq 0 ]] && echo "  ✓ $pkg"
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo ""
        print_warning "Missing (in Npmfile, not installed) (${#missing[@]}):"
        for pkg in "${missing[@]}"; do echo "  ✗ $pkg"; done
    fi

    if [[ ${#untracked[@]} -gt 0 ]]; then
        echo ""
        print_info "Untracked (installed globally, not in Npmfile) (${#untracked[@]}):"
        for pkg in "${untracked[@]}"; do echo "  • $pkg"; done
    fi

    echo ""
    if [[ ${#missing[@]} -eq 0 ]] && [[ ${#untracked[@]} -eq 0 ]]; then
        print_success "Everything is in sync"
    else
        [[ ${#missing[@]} -gt 0 ]] && print_info "Run 'dot npm sync' to install missing packages"
        [[ ${#untracked[@]} -gt 0 ]] && print_info "Run 'dot npm freeze' to track untracked packages, or 'dot npm sync' to remove them"
    fi
}

npm_sync() {
    if ! command_exists npm; then
        print_error "npm is not installed"
        return 1
    fi

    local npmfile
    npmfile=$(_npm_npmfile)

    if [[ ! -f "$npmfile" ]]; then
        print_warning "No Npmfile found at $npmfile"
        print_info "Run 'dot npm freeze' to create one from your current globals"
        return 1
    fi

    print_header "Syncing global npm packages"

    local tracked=()
    local installed=()
    local missing=()
    local untracked=()

    while IFS= read -r line; do tracked+=("$line"); done < <(_npm_list_npmfile)
    while IFS= read -r line; do installed+=("$line"); done < <(_npm_list_global)

    for pkg in "${tracked[@]}"; do
        [[ -z "$pkg" ]] && continue
        local found=0
        for inst in "${installed[@]}"; do [[ "$inst" == "$pkg" ]] && found=1 && break; done
        [[ $found -eq 0 ]] && missing+=("$pkg")
    done

    for inst in "${installed[@]}"; do
        [[ -z "$inst" ]] && continue
        local found=0
        for pkg in "${tracked[@]}"; do [[ "$pkg" == "$inst" ]] && found=1 && break; done
        [[ $found -eq 0 ]] && untracked+=("$inst")
    done

    local did_something=0

    if [[ ${#missing[@]} -gt 0 ]]; then
        print_warning "Packages to install (in Npmfile, not installed):"
        for pkg in "${missing[@]}"; do
            read -p "  Install $pkg? (Y/n): " -n 1 -r; echo ""
            if [[ -z "$REPLY" ]] || [[ "$REPLY" =~ ^[Yy]$ ]]; then
                if npm install -g "$pkg"; then print_success "Installed $pkg"; else print_error "Failed to install $pkg"; fi
                did_something=1
            fi
        done
    fi

    if [[ ${#untracked[@]} -gt 0 ]]; then
        echo ""
        print_info "Packages to remove (installed globally, not in Npmfile):"
        for pkg in "${untracked[@]}"; do
            read -p "  Remove $pkg? (y/N): " -n 1 -r; echo ""
            if [[ "$REPLY" =~ ^[Yy]$ ]]; then
                if npm uninstall -g "$pkg"; then print_success "Removed $pkg"; else print_error "Failed to remove $pkg"; fi
                did_something=1
            fi
        done
    fi

    [[ $did_something -eq 0 ]] && print_success "Everything is in sync"
}

npm_freeze() {
    if ! command_exists npm; then
        print_error "npm is not installed"
        return 1
    fi

    local npmfile
    npmfile=$(_npm_npmfile)

    print_header "Freezing global npm packages to Npmfile"

    local packages=()
    while IFS= read -r line; do packages+=("$line"); done < <(_npm_list_global)

    if [[ ${#packages[@]} -eq 0 ]]; then
        print_warning "No global packages found (excluding npm itself)"
        return 0
    fi

    print_info "Packages to write:"
    for pkg in "${packages[@]}"; do echo "  • $pkg"; done
    echo ""

    if ! ask_confirmation "Overwrite Npmfile with these ${#packages[@]} packages?" "y"; then
        return 0
    fi

    {
        echo "# Global npm packages"
        echo "# One package per line. Supports version pins: package@version"
        echo "# Managed with: dot npm add/remove/freeze/sync"
        echo ""
        for pkg in "${packages[@]}"; do echo "$pkg"; done
    } > "$npmfile"

    print_success "Npmfile written with ${#packages[@]} packages"
}

